SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DEV_SEED_ALLOWED=False

# Production: DEBUG=False and a random SECRET_KEY of at least 50 characters.
# Set ALLOWED_HOSTS to the backend hostname, and CORS/CSRF origins to frontend HTTPS origins.
# Enable this only on a trusted HTTPS-terminating hosting proxy.
TRUST_PROXY_SSL_HEADER=False
# Start at 0; increase after HTTPS is verified.
SECURE_HSTS_SECONDS=0

# Keep local for development. Production photos: public Supabase bucket.
MEDIA_STORAGE=local
SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR_PROJECT_REGION
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=coco-media
SUPABASE_PUBLIC_MEDIA_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/coco-media
# Optional shared throttling cache. Keep empty for local development.
REDIS_URL=
